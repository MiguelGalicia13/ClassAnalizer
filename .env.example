# Configuración de Google Gemini API
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui

# Modelo de Gemini a utilizar (gemini-2.5-flash o gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Directorio base para guardar las grabaciones y guías
OUTPUT_DIR=~/Clases

# Voz para el resumen en audio (TTS con Edge-TTS)
# Opciones en español:
# es-MX-DaliaNeural (Femenino, México)
# es-MX-JorgeNeural (Masculino, México)
# es-ES-AlvaroNeural (Masculino, España)
TTS_VOICE=es-MX-JorgeNeural
