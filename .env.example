# Proveedor de IA para análisis: gemini o anthropic
AI_PROVIDER=gemini

# Configuración de Google Gemini API
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-3.7-flash

# Configuración de Anthropic Claude API
# Obtén tu clave en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=tu_api_key_aqui
ANTHROPIC_MODEL=claude-sonnet-5

# Modelo Whisper local usado antes de enviar el audio a Claude
# Opciones: tiny, base, small, medium, large-v3
WHISPER_MODEL=large-v3

# Directorio base para guardar las grabaciones y guías
OUTPUT_DIR=~/Clases

# Voz para el resumen en audio (TTS con Edge-TTS)
# Opciones en español:
# es-MX-DaliaNeural (Femenino, México)
# es-MX-JorgeNeural (Masculino, México)
# es-ES-AlvaroNeural (Masculino, España)
TTS_VOICE=es-MX-JorgeNeural
